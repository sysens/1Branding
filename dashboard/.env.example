# OneBranding dashboard (admin.onebrandingworld.com). Railway: service "dashboard".

# PostgreSQL of the dashboard (Railway: ${{DashboardPostgres.DATABASE_URL}}).
# Empty in local development: PGlite keeps the data in .data/pglite.
DATABASE_URL=

# 32+ random characters; encrypts API tokens and 2FA keys in the database.
# Never change it after the first start (the stored tokens could not be read).
ENCRYPTION_KEY=

# Shared with the main site's proxy (frontend: NUXT_DASHBOARD_PROXY_SECRET).
NUXT_PROXY_SECRET=

# Lets the first owner be created at /login once; remove it afterwards.
NUXT_SETUP_TOKEN=

# This dashboard's own address (links in Telegram messages, webhook URLs).
NUXT_PUBLIC_APP_URL=https://admin.onebrandingworld.com
# The public site, for the UTM link builder.
NUXT_PUBLIC_SITE_URL=https://onebrandingworld.com

# Optional: API tokens can also be set here instead of Settings → Connections
# (a value saved in Settings wins). Names: TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID,
# META_ACCESS_TOKEN, META_AD_ACCOUNT_ID, META_PIXEL_ID, META_CAPI_TOKEN,
# META_APP_SECRET, INSTAGRAM_ACCOUNT_ID, INSTAGRAM_ACCESS_TOKEN,
# INSTAGRAM_VERIFY_TOKEN, GOOGLE_ADS_DEVELOPER_TOKEN, GOOGLE_ADS_CLIENT_ID,
# GOOGLE_ADS_CLIENT_SECRET, GOOGLE_ADS_REFRESH_TOKEN, GOOGLE_ADS_CUSTOMER_ID,
# GOOGLE_ADS_LOGIN_CUSTOMER_ID, YANDEX_DIRECT_TOKEN, YANDEX_DIRECT_CLIENT_LOGIN,
# TURNSTILE_SECRET.
# GOOGLE_ADS_API_VERSION=v22

# Local development only:
# NUXT_AUTH_REQUIRE_2FA=false
