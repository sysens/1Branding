{
  "private": true,
  "scripts": {
    "postinstall": "bun --cwd=frontend install && bun --cwd=backend install",
    "dev": "bun run --cwd=frontend dev",
    "dev:backend": "bun run --cwd=backend develop",
    "dev:all": "bun run --parallel dev dev:backend",
    "build": "bun run --cwd=frontend build",
    "build:backend": "bun run --cwd=backend build",
    "build:all": "bun run build && bun run build:backend",
    "start": "bun run --cwd=frontend start",
    "start:backend": "bun run --cwd=backend start",
    "generate": "bun run --cwd=frontend generate",
    "lint": "bun run --cwd=frontend lint",
    "typecheck": "bun run --cwd=frontend typecheck && bun run --cwd=backend typecheck"
  },
  "dependencies": {
    "mathjs": "^15.2.0",
    "vue3-lottie": "^3.3.1"
  }
}