NUXT_PUBLIC_GRAPHQL_URL=http://127.0.0.1:1337/graphql
# Production origin used for canonical/hreflang URLs, robots.txt and sitemap.xml.
# Set it on every deployment (e.g. https://onebranding.uz) so mirror hosts such as
# *.up.railway.app canonicalise to the real domain.
NUXT_PUBLIC_SITE_URL=
# Optional Organization JSON-LD contacts (only real, public details).
NUXT_PUBLIC_ORG_PHONE=
NUXT_PUBLIC_ORG_EMAIL=
# Comma-separated public profile URLs (Instagram, Telegram, Behance, LinkedIn...).
NUXT_PUBLIC_ORG_SAME_AS=
NUXT_HOST=127.0.0.1
NUXT_PORT=3000
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
