NUXT_PUBLIC_GRAPHQL_URL=http://127.0.0.1:1337/graphql
# Production origin used for canonical/hreflang URLs, robots.txt and sitemap.xml.
# Set it on every deployment (e.g. https://onebranding.uz) so mirror hosts such as
# *.up.railway.app canonicalise to the real domain.
NUXT_PUBLIC_SITE_URL=
# Optional Organization JSON-LD contacts (only real, public details).
NUXT_PUBLIC_ORG_PHONE=
NUXT_PUBLIC_ORG_EMAIL=
# Comma-separated public profile URLs (Instagram, Telegram, Behance, LinkedIn...).
NUXT_PUBLIC_ORG_SAME_AS=
NUXT_HOST=127.0.0.1
NUXT_PORT=3000
NITRO_HOST=127.0.0.1
NITRO_PORT=3000
# Server-only: the CRM/analytics dashboard on Railway's private network, which
# the site's /api/ob proxy forwards to (e.g. http://dashboard.railway.internal:3000).
NUXT_DASHBOARD_INTERNAL_URL=
# Server-only: the shared secret the proxy sends the dashboard (x-ob-proxy-secret).
NUXT_DASHBOARD_PROXY_SECRET=
# Google Tag Manager container (GTM-XXXX); empty = not loaded.
NUXT_PUBLIC_GTM_ID=
# Meta Pixel ID (digits); empty = not loaded.
NUXT_PUBLIC_META_PIXEL_ID=
# Google Ads account (AW-XXXXXXXXX) and the label of its lead conversion (sent on form_submit).
NUXT_PUBLIC_GOOGLE_ADS_ID=
NUXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Cloudflare Turnstile site key for the request form; empty = no challenge.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
