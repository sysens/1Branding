NODE_ENV=production
# "::" listens on IPv6 too, which Railway's private network may need.
HOST=::
PORT=1337
IS_PROXIED=true
PROXY_MAX_IPS_COUNT=1
# Replace with actual browser frontend origins; include both www/apex if used.
CORS_ORIGINS=https://onebrandingworld.com,https://www.onebrandingworld.com,https://onebranding.up.railway.app
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false

# Strapi secrets
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me-api-token-salt
ADMIN_JWT_SECRET=change-me-admin-jwt-secret
TRANSFER_TOKEN_SALT=change-me-transfer-token-salt
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-encryption-key

# Public URL
PUBLIC_BASE_URL=https://api.example.com

# Railway Postgres
DATABASE_CLIENT=postgres
DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_SCHEMA=public
DATABASE_POOL_MIN=0
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT=60000

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Uploads go to Cloudflare R2 (the container has no persistent disk).
UPLOAD_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=1branding
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
R2_ROOT_PATH=uploads
R2_REGION=auto
UPLOAD_MAX_FILE_SIZE_MB=128
# Cache-Control max-age for /uploads/* (seconds). Not immutable: "Replace media" keeps the URL.
UPLOAD_CACHE_MAX_AGE_SECONDS=86400
