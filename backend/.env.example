HOST=0.0.0.0
PORT=1337
# Set true only behind a trusted reverse proxy; match the actual proxy hop count.
IS_PROXIED=false
PROXY_MAX_IPS_COUNT=1
# Set to the exact frontend origins (comma separated) in production. No wildcard.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
UPLOAD_PROVIDER=local
UPLOAD_MAX_FILE_SIZE_MB=128
# Cache-Control max-age for /uploads/* (seconds). Not immutable: "Replace media" keeps the URL.
UPLOAD_CACHE_MAX_AGE_SECONDS=86400

# Default local database mode
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Optional production database mode
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://user:password@host:5432/database

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
PUBLIC_BASE_URL=https://your-backend-domain
